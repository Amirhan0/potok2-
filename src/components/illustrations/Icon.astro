---
interface Props {
  name:
    | "truck"
    | "ruler"
    | "leaf"
    | "return"
    | "star"
    | "arrow"
    | "phone"
    | "mail"
    | "pin"
    | "clock"
    | "menu"
    | "close"
    | "send"
    | "check"
    | "sun"
    | "moon";
  class?: string;
}
const { name, class: className } = Astro.props;

const icons: Record<Props["name"], string> = {
  truck: "M3 6h11v10H3z M14 10h4l3 3v3h-7z M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z",
  ruler: "M3 15 15 3l6 6L9 21z M7 11l2 2 M10 8l2 2 M13 5l2 2 M4 14l2 2",
  leaf: "M5 19c0-9 6-14 15-14 0 9-5 15-14 15 M5 19c3-4 6-7 10-9",
  return: "M9 14 4 9l5-5 M4 9h11a5 5 0 0 1 0 10h-3",
  star: "M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9z",
  arrow: "M5 12h14 M13 6l6 6-6 6",
  phone: "M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2",
  mail: "M3 6h18v12H3z M3 7l9 6 9-6",
  pin: "M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z M12 11.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z",
  clock: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M12 7v5l3 2",
  menu: "M4 7h16 M4 12h16 M4 17h16",
  close: "M6 6l12 12 M18 6 6 18",
  send: "M22 2 11 13 M22 2l-7 20-4-9-9-4z",
  check: "M5 12l5 5L20 7",
  sun: "M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M12 2v2 M12 20v2 M4.9 4.9l1.4 1.4 M17.7 17.7l1.4 1.4 M2 12h2 M20 12h2 M4.9 19.1l1.4-1.4 M17.7 6.3l1.4-1.4",
  moon: "M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z",
};
---

<svg
  viewBox="0 0 24 24"
  class={className}
  fill={name === "star" ? "currentColor" : "none"}
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={icons[name]} />
</svg>
