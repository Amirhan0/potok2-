---
// Вешалка с вещью — фрагмент SVG (<g>), используется внутри других иллюстраций
import type { GarmentKind } from "../../data/products";
import { garments, hangerPath, toneColors, type Tone } from "./garments";

interface Props {
  kind: GarmentKind;
  tone: Tone;
  hanger?: boolean;
}

const { kind, tone, hanger = true } = Astro.props;
const shape = garments[kind];
const color = toneColors[tone];
---

<g>
  {hanger && <path d={hangerPath} fill="none" stroke="var(--color-navy-900)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />}
  <path d={shape.body} fill={color.fill} stroke="var(--color-navy-900)" stroke-width="3" stroke-linejoin="round" />
  <path d={shape.details} fill="none" stroke={color.line} stroke-width="2.5" stroke-linecap="round" opacity="0.85" />
  {shape.dots?.map(([cx, cy]) => <circle cx={cx} cy={cy} r="4" fill={color.line} />)}
</g>
