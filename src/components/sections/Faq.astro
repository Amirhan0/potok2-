---
import { faq } from "../../data/faq";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../illustrations/Icon.astro";
---

<section id="faq" aria-labelledby="faq-title" class="bg-surface py-20 md:py-28">
  <div class="mx-auto max-w-3xl px-5 md:px-8">
    <SectionHeading id="faq-title" eyebrow="Вопросы" title="Частые вопросы" />
    <div class="space-y-3">
      {faq.map((item, i) => (
        <details class="group rounded-2xl border-2 border-line bg-page open:border-blue-400" name="faq" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-lg font-bold [&::-webkit-details-marker]:hidden">
            {item.q}
            <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-tint text-link transition-transform group-open:rotate-45 group-open:bg-blue-600 group-open:text-white">
              <Icon name="close" class="size-4 rotate-45" />
            </span>
          </summary>
          <p class="px-6 pb-6 leading-relaxed text-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
