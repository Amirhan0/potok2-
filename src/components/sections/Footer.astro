---
import { site } from "../../data/site";
import Icon from "../illustrations/Icon.astro";
import Stitch from "../illustrations/Stitch.astro";

const year = new Date().getFullYear();
const contacts = [
  { icon: "phone", label: site.phone, href: site.phoneHref },
  { icon: "mail", label: site.email, href: `mailto:${site.email}` },
  { icon: "send", label: "Telegram", href: site.telegram },
  { icon: "pin", label: site.address },
  { icon: "clock", label: site.hours },
] as const;
---

<footer class="bg-navy-900 text-blue-100 dark:border-t dark:border-white/10">
  <Stitch class="h-6 w-full text-blue-600" />
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 md:grid-cols-3 md:px-8">
    <div>
      <a href="#top" class="flex items-center gap-2.5 font-display text-2xl font-bold text-white">
        <img src="/favicon.svg" alt="" width="40" height="40" class="size-10" loading="lazy" />
        {site.name}
      </a>
      <p class="mt-4 max-w-xs leading-relaxed">Одежда из натуральных тканей с бесплатной консультацией стилиста.</p>
    </div>

    <nav aria-label="Навигация в подвале">
      <h2 class="mb-4 font-display text-sm font-semibold tracking-widest text-white uppercase">Разделы</h2>
      <ul class="space-y-2">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} class="hover:text-white">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="mb-4 font-display text-sm font-semibold tracking-widest text-white uppercase">Контакты</h2>
      <ul class="space-y-3">
        {contacts.map((c) => (
          <li class="flex items-center gap-3">
            <Icon name={c.icon} class="size-5 shrink-0 text-coral-300" />
            {"href" in c ? (
              <a href={c.href} class="hover:text-white">
                {c.label}
              </a>
            ) : (
              <span>{c.label}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-wrap justify-between gap-4 px-5 py-6 text-sm md:px-8">
      <p>
        © {year} {site.name}. Все права защищены.
      </p>
      <a id="privacy" href="#privacy" class="hover:text-white">
        Политика конфиденциальности
      </a>
    </div>
  </div>
</footer>
