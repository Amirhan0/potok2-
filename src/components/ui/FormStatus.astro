---
interface Props {
  tone?: "light" | "dark";
  class?: string;
}
const { tone = "light", class: className } = Astro.props;
---

<p
  data-status
  role="status"
  aria-live="polite"
  class:list={[
    "min-h-6 text-sm font-semibold",
    tone === "dark"
      ? "text-blue-100 group-data-[state=error]/form:text-coral-300"
      : "text-muted group-data-[state=error]/form:text-error group-data-[state=success]/form:text-link",
    className,
  ]}
></p>
