---
import Button from "./Button.astro";

interface Props {
  variant?: "primary" | "accent";
  class?: string;
}
const { variant = "primary", class: className } = Astro.props;
---

<Button type="submit" variant={variant} size="lg" class={className}>
  <svg
    class="hidden size-5 animate-spin group-data-[state=submitting]/form:block"
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity="0.25"></circle>
    <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
  </svg>
  <slot />
</Button>
